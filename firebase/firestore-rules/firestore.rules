rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isLoggedIn() {
      return request.auth != null;
    }

    // ── All service collections: public read, authenticated write ─────────────
    match /hospitals/{id}            { allow read: if true; allow write: if isLoggedIn(); }
    match /doctors/{id}              { allow read: if true; allow write: if isLoggedIn(); }
    match /ambulances/{id}           { allow read: if true; allow write: if isLoggedIn(); }
    match /emergency_contacts/{id}   { allow read: if true; allow write: if isLoggedIn(); }
    match /upazilas/{id}             { allow read: if true; allow write: if isLoggedIn(); }
    match /news/{id}                 { allow read: if true; allow write: if isLoggedIn(); }
    match /pharmacies/{id}           { allow read: if true; allow write: if isLoggedIn(); }
    match /education/{id}            { allow read: if true; allow write: if isLoggedIn(); }
    match /transport/{id}            { allow read: if true; allow write: if isLoggedIn(); }
    match /finance/{id}              { allow read: if true; allow write: if isLoggedIn(); }
    match /professionals/{id}        { allow read: if true; allow write: if isLoggedIn(); }
    match /organizations/{id}        { allow read: if true; allow write: if isLoggedIn(); }
    match /jobs/{id}                 { allow read: if true; allow write: if isLoggedIn(); }
    match /tourism/{id}              { allow read: if true; allow write: if isLoggedIn(); }
    match /notable_persons/{id}      { allow read: if true; allow write: if isLoggedIn(); }
    match /islamic_places/{id}       { allow read: if true; allow write: if isLoggedIn(); }
    match /electricity_offices/{id}  { allow read: if true; allow write: if isLoggedIn(); }
    match /businesses/{id}           { allow read: if true; allow write: if isLoggedIn(); }
    match /business_requests/{id}    { allow read: if true; allow write: if isLoggedIn(); }

    // Gallery: public read, authenticated write
    match /gallery/{id} {
      allow read:  if true;
      allow write: if isLoggedIn();
    }

    // Blood donors: public read, authenticated write
    match /blood_donors/{id} {
      allow read:  if true;
      allow write: if isLoggedIn();
    }

    // Users: authenticated read/write
    match /users/{userId} {
      allow read, write: if isLoggedIn();
    }
  }
}
