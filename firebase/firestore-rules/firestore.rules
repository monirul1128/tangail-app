rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    function isLoggedIn() {
      return request.auth != null;
    }

    // ── Public read / Admin write collections ─────────────────────────────────
    // hospitals, doctors, ambulances, emergency_contacts, upazilas,
    // news, pharmacies, education, transport, finance, professionals,
    // organizations, jobs, tourism, gallery, notable_persons
    match /hospitals/{id}           { allow read: if true; allow write: if isAdmin(); }
    match /doctors/{id}             { allow read: if true; allow write: if isAdmin(); }
    match /ambulances/{id}          { allow read: if true; allow write: if isAdmin(); }
    match /emergency_contacts/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /upazilas/{id}            { allow read: if true; allow write: if isAdmin(); }
    match /news/{id}                { allow read: if true; allow write: if isAdmin(); }
    match /pharmacies/{id}          { allow read: if true; allow write: if isAdmin(); }
    match /education/{id}           { allow read: if true; allow write: if isAdmin(); }
    match /transport/{id}           { allow read: if true; allow write: if isAdmin(); }
    match /finance/{id}             { allow read: if true; allow write: if isAdmin(); }
    match /professionals/{id}       { allow read: if true; allow write: if isAdmin(); }
    match /organizations/{id}       { allow read: if true; allow write: if isAdmin(); }
    match /jobs/{id}                { allow read: if true; allow write: if isAdmin(); }
    match /tourism/{id}             { allow read: if true; allow write: if isAdmin(); }
    match /notable_persons/{id}     { allow read: if true; allow write: if isAdmin(); }

    // ── Gallery: public read, authenticated create, admin approve ────────────
    match /gallery/{id} {
      allow read:   if true;
      allow create: if isLoggedIn();
      allow update, delete: if isAdmin();
    }

    // ── Blood donors: public read, self register & update ────────────────────
    match /blood_donors/{donorId} {
      allow read:   if true;
      allow create: if isLoggedIn();
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ── Businesses: verified public read, authenticated create, owner update ─
    match /businesses/{businessId} {
      allow read:   if true;
      allow create: if isLoggedIn();
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ── Business registration requests: authenticated submit, admin manage ───
    match /business_requests/{id} {
      allow create: if isLoggedIn();
      allow read, update, delete: if isAdmin();
    }

    // ── Users: own profile only, admin can read all ───────────────────────────
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      allow read:        if isAdmin();
    }
  }
}
