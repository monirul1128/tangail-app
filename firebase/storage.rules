rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Admin uploads — only authenticated admins
    match /hospitals/{allPaths=**} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    match /doctors/{allPaths=**} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    match /news/{allPaths=**} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    match /gallery/{allPaths=**} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    match /tourism/{allPaths=**} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // General uploads folder
    match /uploads/{allPaths=**} {
      allow read:  if true;
      allow write: if request.auth != null;
    }
  }
}
